<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Wymuszenie HTTPS i usunięcie przedrostka www
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 2. Przekierowanie "index.html" oraz "index" na czystą domenę główną (/)
    RewriteCond %{THE_REQUEST} /index(\.html)? [NC]
    RewriteRule ^index(\.html)?$ / [L,R=301]

    # 3. Usunięcie końcówki .html z widocznego paska adresu
    RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
    RewriteRule ^ /%1 [NC,L,R=301]

    # 4. Wewnętrzne mapowanie czystych adresów na fizyczne pliki .html na serwerze
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>

# 5. Zabezpieczenie przed przeglądaniem struktury katalogów serwera
Options -Indexes

# 6. Kompresja GZIP dla znacznie szybszego ładowania plików
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript image/svg+xml
</IfModule>


# 8. Niestandardowa strona błędu 404 (odkomentuj poniższą linię, jeśli stworzysz plik 404.html)
# ErrorDocument 404 /404.html