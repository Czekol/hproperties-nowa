                <div class="contact__info-container">

                </div>

            </div>

        </section>
    </main>




    <!-- @include 'partials/footer.kit' -->


    <script>
        window.addEventListener('message', (event) => {
            // Zabezpieczenie domeny
            if (event.origin !== "https://sonarhome.pl") return;

            // NOWOŚĆ 1: Logujemy w konsoli absolutnie wszystko, co wysyła SonarHome
            console.log("Wiadomość z SonarHome:", event.data);

            const iframe = document.getElementById('sonarhome-iframe');
            if (!iframe) return;

            // --- OBSŁUGA WYSOKOŚCI ---
            let heightToSet = null;
            if (typeof event.data === 'object' && event.data.height) {
                heightToSet = event.data.height;
            } else if (typeof event.data === 'string') {
                try {
                    const parsed = JSON.parse(event.data);
                    if (parsed.height) heightToSet = parsed.height;
                } catch (e) { }
            }

            if (heightToSet) {
                let buffer = 0;
                const screenWidth = window.innerWidth;
                if (screenWidth < 744) {
                    buffer = 40;
                } else if (screenWidth >= 744 && screenWidth < 1440) {
                    buffer = 60;
                } else if (screenWidth >= 1440) {
                    buffer = 70;
                }
                iframe.style.height = (heightToSet + buffer) + 'px';
            }

            // --- NOWOŚĆ 2: OBSŁUGA PRZEKIEROWANIA ---
            // Szukamy, czy SonarHome nie wysłał nam linku do kolejnego kroku
            let redirectUrl = null;
            if (typeof event.data === 'object') {
                redirectUrl = event.data.redirectUrl || event.data.redirect || event.data.url || event.data.redirectTo;
            } else if (typeof event.data === 'string') {
                try {
                    const parsed = JSON.parse(event.data);
                    redirectUrl = parsed.redirectUrl || parsed.redirect || parsed.url || parsed.redirectTo;
                } catch (e) { }
            }

            // Jeśli znaleźliśmy link, automatycznie przenosimy tam użytkownika
            if (redirectUrl && typeof redirectUrl === 'string' && redirectUrl.startsWith('http')) {
                window.location.href = redirectUrl;
            }
        });
    </script>

    <script src="../dist/js/main.min.js"></script>
</body>

</html>
