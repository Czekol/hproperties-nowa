                                    <label for="dzialka">Земельна ділянка</label>
                                </div>
                                <div class="checkbox-box">
                                    <input type="checkbox" name="property_types[]" value="Lokale" id="lokal">
                                    <label for="lokal">Комерційне приміщення</label>
                                </div>
                                <div class="checkbox-box">
                                    <input type="checkbox" name="property_types[]" value="Hale" id="hala">
