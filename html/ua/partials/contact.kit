<section class="contact" id="contact">
            <h2 class="section-heading">Контакти</h2>

            <div class="main-container ">
                <form action="../send.php" method="POST" class="contact__form-container">

                    <!-- Honeypot (ukryte pole anty-spam) -->
                    <input type="text" name="company" style="display:none">

                    <div class="name-phone-box">

                        <div class="text">
                            <label for="name" class="name">Ім’я</label>
                            <input type="text" id="name" name="name" placeholder="Олена" required>
                        </div>

                        <div class="text">
                            <label for="phone" class="phone">Номер телефону</label>
                            <input type="text" id="phone" name="phone" placeholder="123 456 789" required>
                        </div>

                    </div>

                    <div class="textarea-box">
                        <label for="message">Повідомлення</label>
                        <textarea id="message" name="message"
                            placeholder="<!-- $messagePlaceholder -->"
                            required></textarea>
                    </div>

                    <div>
                        <label class="checkbox-label">Чим ми можемо вам допомогти?</label>
                        <div class="checkbox-container">
                            <div class="checkbox-section-container">
                                <div class="checkbox-box"><input type="checkbox" name="property_types[]" value="Zmienić na większe" id="help-bigger"><label for="help-bigger">Змінити на більше</label></div>
                                <div class="checkbox-box"><input type="checkbox" name="property_types[]" value="Zmienić na mniejsze" id="help-smaller"><label for="help-smaller">Змінити на менше</label></div>
                                <div class="checkbox-box"><input type="checkbox" name="property_types[]" value="Zmienić na nowsze" id="help-newer"><label for="help-newer">Змінити на новіше</label></div>
                            </div>
                            <div class="checkbox-section-container">
                                <div class="checkbox-box"><input type="checkbox" name="property_types[]" value="Chcę sprzedać" id="help-sell"><label for="help-sell">Хочу продати</label></div>
                                <div class="checkbox-box"><input type="checkbox" name="property_types[]" value="Sprzedać ze spadku" id="help-inheritance"><label for="help-inheritance">Продати спадщину</label></div>
                                <div class="checkbox-box"><input type="checkbox" name="property_types[]" value="Chcę kupić" id="help-buy"><label for="help-buy">Хочу купити</label></div>
                            </div>
                            <div class="checkbox-section-container">
                                <div class="checkbox-box"><input type="checkbox" name="property_types[]" value="Wynajem" id="help-rent"><label for="help-rent">Оренда</label></div>
                                <div class="checkbox-box"><input type="checkbox" name="property_types[]" value="Inwestycje" id="help-invest"><label for="help-invest">Інвестиції</label></div>
                                <div class="checkbox-box"><input type="checkbox" name="property_types[]" value="Inne" id="help-other"><label for="help-other">Інше</label></div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="send-button">Надіслати повідомлення</button>
                    <p class="form-privacy">Адміністратор даних – H.Properties. Дані з форми ми обробляємо з метою відповіді на запит. Докладніше в <a href="privacy-policy.html">Політиці конфіденційності</a>.</p>
                </form>


                <div class="footer__top-container">

                    <div class="top-second-container">
                        <div class="write-to-us__box">
                            <p class="write-to-us__box-title">Напишіть нам</p>
                            <p class="write-to-us__box-text">Маєте запитання або хочете домовитися про консультацію? Заповніть
                                форму, і ми передзвонимо вам ще сьогодні</p>
                        </div>

                        <div class="top-box">
                            <img src="../dist/img/mail-icon.png" alt="" class="gmail-icon">

                            <div class="top__box">
                                <p class="top__box-title">Email</p>
                                <p class="top__box-text">Надішліть лист, а решту ми візьмемо на себе</p>
                                <a class="top__box-link" href="mailto:kontakt@hproperties.pl">Kontakt@hproperties.pl</a>
                            </div>
                        </div>

                        <div class="top-box">
                            <img src="../dist/img/locatin-icon.png" alt="" class="location-icon">

                            <div class="top__box">
                                <p class="top__box-title">Ми тут</p>
                                <p class="top__box-text">
                                    Поговорімо в офісі за кавою
                                </p>
                                <a class="top__box-link" href="https://maps.app.goo.gl/cXuazeJ2jq4BsAKA7">Józefa
                                    Wybickiego 3A/104, 31-302 Kraków</a>
                            </div>
                        </div>

                        <div class="top-box">
                            <img src="../dist/img/phone-icon.png" alt="" class="instagram-icon">

                            <div class="top__box">
                                <p class="top__box-title">Номер телефону</p>
                                <p class="top__box-text">Зателефонуйте, і ми домовимося про зручний час зустрічі</p>
                                <a class="top__box-link" href="tel:+48572910341">572 910 341</a>
                            </div>
                        </div>
                    </div>

                    <div class="social-media__box">

                        <a href="https://www.facebook.com/profile.php?id=61573598463451"
                            aria-label="Наш профіль у Facebook">
                            <img src="../dist/img/facebook-icon.png" alt="" class="social-media__box-icon">
                        </a>

                        <a href="https://www.tiktok.com/@hproperties?_t=ZN-90wVJ21d3oM&_r=1"
                            aria-label="Наш профіль у TikTok">
                            <img src="../dist/img/tiktok-icon.png" alt="" class="social-media__box-icon">
                        </a>

                        <a href="https://www.instagram.com/h.properties_nieruchomoscikrk/"
                            aria-label="Наш профіль в Instagram">
                            <img src="../dist/img/instagram-icon.png" alt="" class="social-media__box-icon">
                        </a>


                    </div>


                </div>

                <div class="contact__info-container">

                </div>

            </div>

        </section>